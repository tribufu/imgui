{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "include": [
        "CMake${hostSystemName}Presets.json"
    ],
    "configurePresets": [
        {
            "name": "android",
            "hidden": true,
            "inherits": [
                "base",
                "ninja"
            ],
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_HOME}",
                "CMAKE_ANDROID_API": "28",
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
            }
        },
        {
            "name": "android-arm64",
            "inherits": [
                "android"
            ],
            "cacheVariables": {
                "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
                "VCPKG_TARGET_TRIPLET": "arm64-android"
            }
        },
        {
            "name": "android-arm",
            "inherits": [
                "android"
            ],
            "cacheVariables": {
                "CMAKE_ANDROID_ARCH_ABI": "armeabi-v7a",
                "CMAKE_ANDROID_ARM_MODE": "ON",
                "VCPKG_TARGET_TRIPLET": "arm-android"
            }
        },
        {
            "name": "android-x64",
            "inherits": [
                "android"
            ],
            "cacheVariables": {
                "CMAKE_ANDROID_ARCH_ABI": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-android"
            }
        },
        {
            "name": "android-x86",
            "inherits": [
                "android"
            ],
            "cacheVariables": {
                "CMAKE_ANDROID_ARCH_ABI": "x86",
                "VCPKG_TARGET_TRIPLET": "x86-android"
            }
        },
        {
            "name": "web",
            "inherits": [
                "base",
                "ninja"
            ],
            "cacheVariables": {
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "VCPKG_TARGET_TRIPLET": "wasm32-emscripten"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-android-arm64",
            "configurePreset": "android-arm64",
            "configuration": "Debug"
        },
        {
            "name": "release-android-arm64",
            "configurePreset": "android-arm64",
            "configuration": "Release"
        },
        {
            "name": "debug-android-arm",
            "configurePreset": "android-arm",
            "configuration": "Debug"
        },
        {
            "name": "release-android-arm",
            "configurePreset": "android-arm",
            "configuration": "Release"
        },
        {
            "name": "debug-android-x64",
            "configurePreset": "android-x64",
            "configuration": "Debug"
        },
        {
            "name": "release-android-x64",
            "configurePreset": "android-x64",
            "configuration": "Release"
        },
        {
            "name": "debug-android-x86",
            "configurePreset": "android-x86",
            "configuration": "Debug"
        },
        {
            "name": "release-android-x86",
            "configurePreset": "android-x86",
            "configuration": "Release"
        },
        {
            "name": "debug-web",
            "configurePreset": "web",
            "configuration": "Debug"
        },
        {
            "name": "release-web",
            "configurePreset": "web",
            "configuration": "Release"
        }
    ]
}
