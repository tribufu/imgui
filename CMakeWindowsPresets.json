{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "include": [
        "CMakeBasePresets.json"
    ],
    "configurePresets": [
        {
            "name": "vs2026",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": [
                "base",
                "vs2026",
                "msvc"
            ],
            "cacheVariables": {}
        },
        {
            "name": "windows-x64",
            "inherits": [
                "windows"
            ],
            "architecture": "x64",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            }
        },
        {
            "name": "windows-x86",
            "inherits": [
                "windows"
            ],
            "architecture": "Win32",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x86-windows"
            }
        },
        {
            "name": "windows-arm64",
            "inherits": [
                "windows"
            ],
            "architecture": "ARM64",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-windows"
            }
        },
        {
            "name": "xbox",
            "hidden": true,
            "inherits": [
                "base",
                "vs2026",
                "msvc"
            ],
            "architecture": "x64",
            "cacheVariables": {}
        },
        {
            "name": "xboxone",
            "inherits": [
                "xbox"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-xbox-xboxone"
            }
        },
        {
            "name": "xboxseries",
            "inherits": [
                "xbox"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-xbox-scarlett"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-windows-x64",
            "configurePreset": "windows-x64",
            "configuration": "Debug"
        },
        {
            "name": "release-windows-x64",
            "configurePreset": "windows-x64",
            "configuration": "Release"
        },
        {
            "name": "debug-windows-x86",
            "configurePreset": "windows-x86",
            "configuration": "Debug"
        },
        {
            "name": "release-windows-x86",
            "configurePreset": "windows-x86",
            "configuration": "Release"
        },
        {
            "name": "debug-windows-arm64",
            "configurePreset": "windows-arm64",
            "configuration": "Debug"
        },
        {
            "name": "release-windows-arm64",
            "configurePreset": "windows-arm64",
            "configuration": "Release"
        }
    ]
}
